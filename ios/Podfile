# Resolve react_native_pods.rb with node to allow for hoisting
require 'tempfile'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Kaka' do
  config = use_native_modules!
  pod 'ZIPFoundation', :git => 'https://github.com/weichsel/ZIPFoundation.git', :tag => '0.9.20'
  pod 'AgoraRtcEngine_iOS/RtcBasic', '4.5.0'
  pod 'NIMSDK', '10.9.10'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # ZIPFoundation 0.9.20 leaves its privacy resource bundle at iOS 12.
    privacy_bundle = installer.pods_project.targets.find do |target|
      target.name == 'ZIPFoundation-ZIPFoundation_Privacy'
    end
    privacy_bundle&.build_configurations&.each do |configuration|
      configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
    end

    # The NIM search framework still includes bitcode in its device slice.
    nim_binary = installer.sandbox.root.join(
      'NIMSDK/NIMFtsDB/NIMFtsDB.xcframework/ios-arm64/NIMFtsDB.framework/NIMFtsDB'
    )
    if nim_binary.file?
      load_commands, status = Pod::Executable.capture_command('/usr/bin/xcrun', ['otool', '-l', nim_binary.to_s])
      raise 'Could not inspect the NIM search framework' unless status.success?
      if load_commands.match?(/^\s*segname __LLVM$/)
        Tempfile.create('nim-without-bitcode', nim_binary.dirname.to_s) do |output|
          output.close
          Pod::Executable.execute_command('/usr/bin/xcrun', ['bitcode_strip', nim_binary.to_s, '-r', '-o', output.path])
          File.chmod(nim_binary.stat.mode & 0777, output.path)
          File.rename(output.path, nim_binary.to_s)
        end
      end
    end
  end
end
